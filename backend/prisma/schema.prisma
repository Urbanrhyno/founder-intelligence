generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model article {
  id          String   @id @default(uuid())
  title       String?
  url         String   @unique
  source      String?
  category    String?
  summary     String?
  score       Float?
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@map("articles")
}